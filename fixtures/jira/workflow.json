  "transitions": [
    {"name": "Ready",        "from": "To Do",        "to": "Ready"},
    {"name": "Start",        "from": "Ready",        "to": "In Progress"},
    {"name": "Block",        "from": "In Progress",  "to": "Blocked"},
    {"name": "Unblock",      "from": "Blocked",      "to": "In Progress"},
    {"name": "Pass",         "from": "In Progress",  "to": "Done pending"},
    {"name": "Pass",         "from": "Blocked",      "to": "Done pending"},
    {"name": "Archive",      "from": "Done pending", "to": "Done"},
    {"name": "Won't do",     "from": "*",            "to": "Won't Do"},
    {"name": "Back to ready","from": "In Progress",  "to": "Ready"}
