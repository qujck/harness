  "users": [
    {"accountId": "acc-example", "emailAddress": "example@your-project.example", "displayName": "Example"},
    {"accountId": "acc-tester",  "emailAddress": "tester@your-project.example",  "displayName": "Tester"},
    {"accountId": "acc-po",      "emailAddress": "po@your-project.example",      "displayName": "PO"}
  ]
