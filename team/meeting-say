#!/usr/bin/env python3
"""meeting-say "text": says it to the meeting this session is attending, for everyone in it to hear.
meeting-say --handover "message": at the meeting's end, the message suggested for this agent's own session, which
waits for the owner to send or skip; meeting-say --handover nothing when there is nothing for it.
The meeting and who is speaking come from MEETING_ID and MEETING_AS, which the team page sets when it starts a
meeting session; the page's server takes the line (AGENTS_WEB_PORT, 8787 unless set)."""
import json
import os
import sys
import urllib.error
import urllib.request

args = sys.argv[1:]
handover = bool(args) and args[0] == "--handover"
text = " ".join(args[1:] if handover else args).strip()
mid, who = os.environ.get("MEETING_ID"), os.environ.get("MEETING_AS")
if not mid or not who:
    sys.exit("meeting-say: this session is not in a meeting (no MEETING_ID or MEETING_AS)")
if not text:
    sys.exit('usage: meeting-say "text" | meeting-say --handover "message" | meeting-say --handover nothing')
port = os.environ.get("AGENTS_WEB_PORT", "8787")
req = urllib.request.Request(f"http://127.0.0.1:{port}/api/meeting/{mid}/say", method="POST",
                             data=json.dumps({"as": who, "text": text, "handover": handover}).encode(),
                             headers={"Content-Type": "application/json", "X-Team-Say": "1"})
try:
    with urllib.request.urlopen(req, timeout=10) as r:
        ok = json.load(r).get("ok")
except urllib.error.HTTPError as e:
    sys.exit(f"meeting-say: not said: {e.read().decode().strip() or e.code}")
except OSError as e:
    sys.exit(f"meeting-say: the team page's server did not answer: {e}")
print("suggested to the owner" if handover else "said to the meeting" if ok else "not said")
sys.exit(0 if ok else 1)
