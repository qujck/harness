#!/usr/bin/env python3
"""Tok/min bar: Team's sparkline alone on one low line (team/bar/team), the tokens a minute in its title."""
import json
import sys

agents = json.load(sys.stdin).get("agents") or []
team = [sum(x) for x in zip(*[a["series"] for a in agents if a.get("series")])]
rate = sum(a.get("rate") or 0 for a in agents)
print(json.dumps({"label": "", "name": "Tok/min bar", "slim": True, "icon": "tok", "every": 3, "spark": team,
                  "title": f"Tok/min: the tokens a minute every running agent is using together, over the last while\n{rate} tokens a minute now"}))
