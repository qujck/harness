#!/usr/bin/env python3
"""Week: the account's weekly use against the budget, a bar item for the team page (team/lib/agents_web.py runs it
with the page's numbers on its input). Green on the plan, amber while the week's contingency is being spent, red past
an even share of the whole allowance. While a development day is open (team/agents-day-budget.sh), the day instead:
"Week: 70% - Day: 12%", marked where the week stood when the day started plus its share, amber with 1% of it left, red once spent past it.
Between days (in strength, the verification day) that counts as a day whose share runs to the week's plan."""
import json
import sys

s = json.load(sys.stdin)
w, dy = s.get("week"), s.get("day")
if dy and dy.get("quota") is None:   # between days (the verification day): its share is the room left to the week's plan
    dy = {**dy, "quota": max(s["plan"] - dy["from"], 0)} if s.get("plan") is not None else None
p = dy["from"] + dy["quota"] if dy else s.get("plan")
over = dy["used"] > dy["quota"] if dy else w is not None and p is not None and w >= p
spare = not dy and over and s.get("even") is not None and w < s["even"]
last = dy and not over and dy["quota"] - dy["used"] <= 1   # the day's last 1%
c = "amber" if spare or last else "red" if over else "green"
if w is None:
    value, title = ["no reading"], "No reading of the account's week yet"
elif dy:
    value = [{"text": f"{w}%", "colour": c, "bold": True}, " - Day: ", {"text": f"{dy['used']}%", "colour": c, "bold": True}]
    title = f"The day has used {dy['used']} of its {dy['quota']}% (the week from {dy['from']}%, so it stops past {p}%)"
else:
    value = [{"text": f"{w}%", "colour": c, "bold": True}] + ([f" of {p}% planned"] if p is not None else [])
    title = "The account's week against the budget (team/agents-budget.sh)"
print(json.dumps({"place": "header", "label": "Week", "value": value, "title": title, "every": 5,
                  "meter": {"pct": w or 0, "mark": p, "colour": c if over or last else ""}}))
