#!/usr/bin/env python3
"""Week: the account's weekly use against the budget, a bar item for the team page (team/lib/agents_web.py runs it
with the page's numbers on its input). Green on the plan, amber while the week's contingency is being spent, red past
an even share of the whole allowance. While a development day is open (team/agents-day-budget.sh), the day instead:
"70% used · Day: 12%", marked where the week stood when the day started plus its share, amber with 1% of it left, red once spent past it.
On a verification day the share is only a reading: nothing stops at it, so it never turns amber or red.
Between days that counts as a day whose share is what the week's plan has grown by
since it began (team/agents-day-budget.sh)."""
import json
import sys

s = json.load(sys.stdin)
w, dy = s.get("week"), s.get("day")
if dy and dy.get("quota") is None:   # between days with no plan to share out: the week alone
    dy = None
p = dy["from"] + dy["quota"] if dy else s.get("plan")
nostop = dy and dy.get("nostop")   # a verification day: nothing stops at its share, so it never warns
over = not nostop and (dy["used"] > dy["quota"] if dy else w is not None and p is not None and w >= p)
spare = not dy and over and s.get("even") is not None and w < s["even"]
last = dy and not over and not nostop and dy["quota"] - dy["used"] <= 1   # the day's last 1%
c = "amber" if spare or last else "red" if over else "green"
if w is None:
    value, title = ["no reading"], "No reading of the account's week yet"
elif dy:
    value = [{"text": f"{w}%", "colour": c, "bold": True}, " used", {"text": " · Day: ", "drop": True}, {"text": f"{dy['used']}%", "colour": c, "bold": True, "drop": True}]
    title = (f"The verification day has used {dy['used']} of its {dy['quota']}% (the week from {dy['from']}%); nothing stops at it" if nostop
             else f"The day has used {dy['used']} of its {dy['quota']}% (the week from {dy['from']}%, so it stops past {p}%)")
else:
    gap = None if p is None else round(w - p)
    plan = "" if gap is None else " · on plan" if gap == 0 else f" · {abs(gap)}% {'over' if gap > 0 else 'under'}"
    value = [{"text": f"{w}%", "colour": c, "bold": True}, " used"] + ([{"text": plan, "drop": True}] if plan else [])
    title = f"The account's week against the budget (team/agents-budget.sh): {w}% of the weekly allowance used" + (f", {p}% planned by now" if p is not None else "")
print(json.dumps({"place": "header", "label": "", "name": "Week", "value": value, "title": title, "every": 5,
                  "meter": {"pct": w or 0, "mark": p, "colour": c if over or last else ""}}))
