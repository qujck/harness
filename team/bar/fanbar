#!/usr/bin/env python3
"""Fans bar: the machine's fans, as the Performance pane reads them, on one low line: "Fans: 1040 rpm", the fastest,
beside a short meter, green, of the most power the board gives any of them; amber from 80%, red from 95%. Each fan's
speed and power are in its title. "…" until the page's sampling, which runs while this is in a bar, has a reading;
hidden where no fan chip is read (its driver, nct6775 or it87, not loaded, or a Mac)."""
import json
import sys

fans = (json.load(sys.stdin).get("perf") or {}).get("fans")
base = {"label": "Fans", "name": "Fans bar", "slim": True, "icon": "fan", "every": 2}
if fans is None:
    print(json.dumps({**base, "value": "…", "title": "Reading the fans"}))
elif not fans:
    print(json.dumps({"hidden": True, "name": "Fans bar", "every": 2}))
else:
    top = max(fans, key=lambda f: f["rpm"])
    duty = [f["duty"] for f in fans if f["duty"] is not None]
    item = {**base, "title": "Fans: the fastest fan's speed; the meter is the most power the board gives any of them\n"
            + "\n".join(f"{f['name']}: {f['rpm']} rpm" + (f", power {f['duty']}%" if f["duty"] is not None else "") for f in fans),
            "value": [{"text": f"{top['rpm']} rpm" if top["rpm"] else "stopped", "colour": "text", "bold": True}]}
    if duty:
        p = max(duty)
        item["meter"] = {"pct": p, "mark": None, "colour": "red" if p >= 95 else "amber" if p >= 80 else ""}
    print(json.dumps(item))
