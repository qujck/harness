#!/usr/bin/env python3
"""CPU bar: the machine's CPU busy, as the Performance pane reads it, on one low line: "CPU: 34%" beside a short meter, green;
amber from 80%, red from 95%. "…" until the page's sampling, which runs while this is in a bar, has a reading."""
import json
import sys

s = json.load(sys.stdin)
p = (s.get("perf") or {}).get("cpu")
if p is None:
    print(json.dumps({"label": "CPU", "name": "CPU bar", "slim": True, "icon": "cpu", "every": 2, "value": "…", "title": "Reading the CPU"}))
else:
    c = "red" if p >= 95 else "amber" if p >= 80 else ""
    print(json.dumps({"label": "CPU", "name": "CPU bar", "slim": True, "icon": "cpu", "every": 2, "title": f"CPU: how busy the machine's processors are\n{p}% busy across {s.get('cores')} cores",
                      "value": [{"text": f"{round(p)}%", "colour": c or "green", "bold": True}],
                      "meter": {"pct": p, "mark": None, "colour": c}}))
