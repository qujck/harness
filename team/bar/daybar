#!/usr/bin/env python3
"""Day bar: the open development day's share (team/agents-day-budget.sh) on one low line, "Day: 12%" beside a meter
filled to how much of the share is used; amber with 1% of it left, red once spent past it.
Between days (in strength, the verification day), the same, its share what the week's plan has grown by since it began.
Hidden otherwise."""
import json
import sys

s = json.load(sys.stdin)
dy = s.get("day")
if dy and dy.get("quota") is None:   # between days with no plan to share out: the week alone
    dy = None
if not dy:
    print(json.dumps({"hidden": True, "name": "Day bar"}))
else:
    c = "red" if dy["used"] > dy["quota"] else "amber" if dy["quota"] - dy["used"] <= 1 else "green"
    print(json.dumps({"label": "Day", "name": "Day bar", "slim": True, "every": 5,
                      "value": [{"text": f"{dy['used']}%", "colour": c, "bold": True}],
                      "title": f"The day has used {dy['used']} of its {dy['quota']}% (the week from {dy['from']}%)",
                      "meter": {"pct": 100 * dy["used"] / dy["quota"] if dy["quota"] else 100, "mark": None,
                                "colour": c if c != "green" else ""}}))
