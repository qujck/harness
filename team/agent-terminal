#!/usr/bin/env python3
"""agent-terminal: the owner's terminal this agent is attached to, on the team page. The owner attaches and detaches it.

  agent-terminal read             what the terminal has printed since the last read (nothing from before the attaching)
  agent-terminal read --wait      the same, once the command running there has finished (up to half an hour)
  agent-terminal suggest 'command'    shows the owner a command to run, of one line or several, in a box under the
                                  terminal, in place of the one shown before; "-" reads it from stdin
  agent-terminal suggest --clear  shows none

The owner edits and submits the command: nothing here can type into the terminal. What is read becomes part of this
agent's conversation."""
import json
import os
import subprocess
import sys
import time
import urllib.error
import urllib.request


def ask(what, body):
    port = os.environ.get("AGENT_WEB_PORT") or "8787"
    req = urllib.request.Request(f"http://127.0.0.1:{port}/api/terminal/{what}", method="POST",
                                 data=json.dumps({"as": name, **body}).encode(),
                                 headers={"Content-Type": "application/json", "X-Team-Say": "1"})
    with urllib.request.urlopen(req, timeout=70) as r:
        return json.load(r)


def session_name():
    """The name of the nearest ancestor that is a named Claude session, or ""."""
    pid = os.getpid()
    while pid > 1:
        try:
            with open(os.path.join(os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser("~/.claude"), f"sessions/{pid}.json")) as f:
                if name := str(json.load(f).get("name") or "").lstrip("/"):
                    return name
        except (OSError, ValueError, AttributeError):
            pass
        up = subprocess.run(["ps", "-o", "ppid=", "-p", str(pid)], capture_output=True, text=True).stdout.strip()
        pid = int(up) if up.isdigit() else 0
    return ""


args = sys.argv[1:]
name = os.environ.get("AGENT_NAME") or session_name()
if not name:
    sys.exit("agent-terminal: this session has no name (/rename)")
try:
    if args == ["read"]:
        print(ask("read", {})["text"] or "nothing new")
    elif args == ["read", "--wait"]:
        until, text = time.time() + 1800, ""
        while not text and time.time() < until:
            try:
                text = ask("read", {"wait": 50})["text"]
            except urllib.error.HTTPError:
                raise
            except OSError:   # the team page is being restarted
                time.sleep(3)
        print(text or "nothing new in half an hour")
    elif len(args) == 2 and args[0] == "suggest":
        text = "" if args[1] == "--clear" else sys.stdin.read() if args[1] == "-" else args[1]
        if not text.strip() and args[1] != "--clear":
            sys.exit("agent-terminal: no command given")
        ask("suggest", {"text": text})
        print("shown to the owner, who runs it or not" if text else "cleared")
    else:
        sys.exit(__doc__)
except urllib.error.HTTPError as e:
    sys.exit(f"agent-terminal: {e.read().decode().strip() or e.code}")
except OSError as e:
    sys.exit(f"agent-terminal: the team page's server did not answer: {e}")
