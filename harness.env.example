# harness.env — per-project configuration for the agent harness.
#
# Copy to `harness.env` and fill in. Every script sources this file from the
# repo root. Leave a command BLANK to skip that step entirely — the harness
# adapts to projects with no stack, no e2e, etc.
#
#   cp harness.env.example harness.env

# ── init.sh: bringing the stack up ────────────────────────────────────────
# Idempotent command to start your app/stack. Blank = nothing to start.
UP_CMD="docker compose up -d --build"

# Health endpoint polled after UP_CMD until it returns 2xx. Blank = skip.
HEALTH_URL="http://localhost:5000/health"
HEALTH_TIMEOUT=90

# Space-separated tools that must be on PATH before any work begins.
# (jq is always required by the harness itself and is checked separately.)
REQUIRED_TOOLS="docker curl"

# ── verify.sh: the three layers (Definition of Done) ──────────────────────
# Run in order, stop on first failure. Blank = skip that layer.
VERIFY_STATIC="dotnet build -warnaserror"   # lint / typecheck / compile
VERIFY_UNIT="dotnet test"                    # unit tests
VERIFY_E2E="bash scripts/e2e.sh"             # end-to-end (needs running stack)
VERIFY_UI=""                                 # opt-in browser suite (RUN_UI=1)

# ── pre-commit: when to run verify on commit ──────────────────────────────
# Regex of staged paths that should trigger verify. Blank = always run.
VERIFY_PATH_FILTER="^(src|backend|frontend)/"

# ── handoff.sh: debug-artifact scan ───────────────────────────────────────
# Space-separated regexes. An ADDED line (git diff) matching any one blocks
# handoff. Defaults below catch the usual suspects across JS/TS/C#/Python.
DEBUG_PATTERNS='console\.log debugger; //[[:space:]]*TODO Console\.WriteLine print\((["'"'"']DEBUG)'

# ── parallel development ───────────────────────────────────────────────────
# DISTRIBUTED parallel-safe workflow is the DEFAULT and needs no config: the
# work queue is one file per ticket (features/<id>.json) so concurrent branches
# never conflict on it, depends_on / ready-frontier picks the next ticket, and
# the append-only docs union-merge (.gitattributes). It works across any number
# of separate clones / machines out of the box. See README "Parallel development".
#
# LOCAL parallel (optional) — running several git worktrees on ONE machine. Each
# worktree gets its OWN docker-compose project with kernel-assigned host ports
# (discovered into .agent/env) so they never collide on a port or container.
# REQUIRES a machine that can run several stacks at once AND a docker-compose
# UP_CMD. Leave 0 if you only ever run one stack on this machine — you still get
# the distributed workflow across separate clones.
PER_STREAM_STACKS=0

# Per-stream health probe (PER_STREAM_STACKS=1 only): which compose SERVICE
# publishes the health endpoint, the CONTAINER port it listens on (the HOST port
# is discovered at runtime), and the path to poll. init.sh builds HEALTH_URL from
# the discovered host port and writes it to .agent/env for the other scripts.
STACK_HEALTH_SERVICE="api"
STACK_HEALTH_CONTAINER_PORT="8080"
STACK_HEALTH_PATH="/health"

# ── observability (L11 — optional, not yet implemented) ────────────────────
# The next rung of the framework: emit a structured run record per verify/handoff
# so sessions are debuggable and gradable. The kit ships this OFF and unwired —
# see OBSERVABILITY.md for the adoption path. Uncomment once you've added the
# trace sink (scripts/_observe.sh).
# OBSERVABILITY=0

# ── The ticket store (scripts/lib/ticket-store.sh) ──────────────────────────────────────────────
# One verb set — raise, groom, claim, park, amend, flip-passing, archive, release, frontier … —
# behind scripts/ledger-db.sh; this picks which store answers.
TICKET_STORE=db                    # db (the ledger database, below) | jira (scripts/lib/ticket-store-jira.sh)
# ── Jira (TICKET_STORE=jira; docs/ticket-store-jira.md) — Jira Cloud, REST v3, one project per harness project
JIRA_BASE_URL=                     # https://<site>.atlassian.net
JIRA_PROJECT_KEY=                  # e.g. HAR — the issue KEY is the ticket id
JIRA_EMAIL=                        # the account the API token belongs to
JIRA_API_TOKEN=                    # NEVER in git: harness.env is gitignored; scripts/check-no-committed-jira-token.sh refuses a tracked token
JIRA_STATUS_MAP="not_started=To Do,selected=Ready,in_progress=In Progress,parked=Blocked,passing=Done pending,archived=Done,wont_do=Won't Do"
JIRA_AREA_FIELD=label              # label (area:<area>) | component
JIRA_SESSION_LOG_ISSUE=            # e.g. HAR-1 — session entries (progress.sh new) become comments on this issue
# JIRA_TRANSPORT=fixture           # the in-process fake (self-tests); unset = live
HARNESS_REPO=                      # owner/repo on GitHub — the gate, the seat probe and the required-check check read it
HARNESS_PROJECT=                   # short project name; default = the repo directory's basename. Names the
                                   # ledger compose project/container/network and the worktree prefix.
LEDGER_PORT=55432                  # loopback port of the ledger database (never exposed off the box)
# LEDGER_CONTAINER=                # default "<project>-ledger-db"
# LEDGER_DEPLOY_DIR=               # default ~/.local/state/<project>/ledger-db — the compose file + pgpass live
                                   # OUTSIDE every checkout: one ledger per box, read by every worktree
TICKET_AREAS="ci,docs,backend,frontend,testing,environments"   # the controlled list a raise may name

# ── CI: lanes, the merge seat, the subset, the gate (docs/runbooks/ci-lanes.md) ──────────────────
# Runner LABELS are also GitHub repository VARIABLES of the same names (a workflow cannot read this
# file): MERGE_SEAT_LABEL, LEDGER_LANE_LABEL, CANARY_LABEL, ROUTE_LABEL, LEDGER_LANE_PATHS_RE.
MERGE_SEAT_LABEL=forge-box         # the seat: ONE verify at a time per MERGE_SEAT_RUNNERS (one job per runner)
MERGE_SEAT_RUNNERS=1               # how many runners carry the seat label ON PURPOSE; the probe asserts THIS, not "one"
LEDGER_LANE_LABEL=ledger-lane      # docs/ledger-only PRs: never take the seat
CANARY_LABEL=canary-box            # the hourly full suite and a repair PR
ROUTE_LABEL=route-box              # the route and land jobs (cheap, never the seat)
REQUIRED_CHECKS="route verify"     # the ruleset's required contexts (set in GitHub by hand, once)
LEDGER_LANE_PATHS_RE='^(docs/|infra/ledger-db/|agents/|([^/]+/)*[^/]+\.md$)'   # a diff entirely inside this routes to the ledger lane
FULL_SUITE_WORKFLOW=hourly-full-suite.yml   # the gate reads scheduled runs of this workflow
FULL_SUITE_TIMEOUT_MIN=90          # older than this, the newest hourly is stale: the gate says CANNOT TELL
VERIFY_STEP_BUDGET_S=0             # per-tier wall budget in verify.sh (0 = unbudgeted); over it FAILS the run
UI_BROWSER_SURFACE_RE='^(frontend/|e2e-ui/)'   # paths that can affect the browser at all (scripts/ui-relevant-specs.sh)
UI_SPEC_DIR=e2e-ui/tests           # where the browser specs live
UI_ALWAYS_SPECS=                   # fragment(s) always run when anything is selected, e.g. smoke
                                   # (seeded into ledger.area by ledger-migrate.sh on first apply)

